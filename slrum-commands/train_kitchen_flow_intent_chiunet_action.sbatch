#!/bin/bash
#SBATCH --job-name=kitchen-fi-chi-act
#SBATCH --output=logs/kitchen_flow_intent_chiunet_action_%j.out
#SBATCH --error=logs/kitchen_flow_intent_chiunet_action_%j.err
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=12:00:00

mkdir -p logs
source /home/ldahiya/max_vla/much-ado-about-noising/.venv/bin/activate
cd /home/ldahiya/max_vla/much-ado-about-noising

# Config A variant: MLP intent flow (horizon=1) + ChiUNet action flow (horizon=16)
# Intent is generated by the MLP flow model; the ChiUNet is then conditioned on
# obs_emb ⊕ intent to produce the full action trajectory via flow matching.
NUMBA_CACHE_DIR=/tmp MUJOCO_GL=egl python examples/train_kitchen.py \
    task=kitchen_state_flow_intent \
    network=mlp_flow_intent_chiunet \
    optimization.gradient_steps=300000 \
    optimization.batch_size=256 \
    optimization.loss_type=flow \
    log.eval_episodes=50 \
    log.eval_freq=20000 \
    log.save_freq=50000 \
    log.project=intent-conditioning-comparison \
    log.group=kitchen-state \
    log.exp_name=flow_intent_chiunet_action \
    task.num_envs=5 \
    optimization.auto_resume=false \
    log.save_video=false
